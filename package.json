{
  "name": "ianwu-portfolio",
  "private": true,
  "description": "Builds the compiled Tailwind stylesheet for ianwu.co.uk.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
